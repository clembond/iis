<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <remove value="default.aspx" />
                <remove value="iisstart.htm" />
                <remove value="Default.asp" />
                <remove value="Default.htm" />
                <remove value="index.html" />
                <remove value="index.htm" />
                <add value="aexp4b.asp" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="redirect to http" patternSyntax="ExactMatch" stopProcessing="true">
                    <match url="psw.verifyme.local" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{QUERY_STRING}" pattern="psw.verifyme.local" />
                    </conditions>
                    <action type="Redirect" url="http://psw.verifyme.local" />
                </rule>
                <rule name="asset" stopProcessing="true">
                    <match url="asset.verifyme.local" />
                    <action type="Redirect" url="http://asset.verifyme.local:8081" />
                </rule>
            </rules>
        </rewrite>
       
    </system.webServer>
</configuration>
